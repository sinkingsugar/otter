// The 1.x client of the HTTP concurrency benchmark (see run.sh). Matched
// with otter-io's bench_http example: N wires, each doing one Http.Get
// (Timeout: 30) against the shared latency server. Spawning (which in 1.x
// also clones and composes each copy) is timed as creation; waiting for every
// request to finish is timed as execution. Failed requests are counted, so a
// run cannot look faster by doing less.
//   shards client-1x.shs url:http://127.0.0.1:18090/work instances:100

@define(url "http://127.0.0.1:18090/work" IgnoreRedefined: true)
@define(instances "100" IgnoreRedefined: true)

@mesh(root)

@wire(req {
  Maybe({
    none
    Http.Get(@url Timeout: 30)
    Inc(done)
  } {
    Inc(failed)
  })
})

@wire(driver {
  @instances | ParseInt = n
  0 | Set(done Global: true)
  0 | Set(failed Global: true)

  Time.NowMs = create-start
  Repeat({Spawn(req)} Times: n)
  Time.NowMs | Sub(create-start) = create-ms

  Time.NowMs = exec-start
  0 >= ticks
  Repeat({
    Pause(0.0)
    Inc(ticks)
  } Until: {done | Add(failed) | IsMoreEqual(n)})
  Time.NowMs | Sub(exec-start) = exec-ms

  ["BENCH runtime=1.x instances=" n " create_ms=" create-ms " exec_ms=" exec-ms " ticks=" ticks " ok=" done " failed=" failed]
  String.Format | Log
})

@schedule(root driver)
@run(root) | Assert.Is(true)
